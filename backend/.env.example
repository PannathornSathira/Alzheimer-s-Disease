# Local Docker PostgreSQL. In Render, set DATABASE_URL and DIRECT_URL to the
# Supabase Session Pooler URL in the Render dashboard, never in this file.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/alzheimer_trial?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/alzheimer_trial?schema=public"
# Optional comma-separated extra origins are supported in production.
FRONTEND_ORIGIN="http://localhost:5173"
